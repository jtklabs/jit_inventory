# Database
DATABASE_URL=postgresql://inventory:inventory_pass@db:5432/inventory

# Credential Management
CREDENTIAL_BACKEND=local  # 'local' for dev, 'aws' for prod
CREDENTIAL_PATH=/app/data/credentials

# AWS (for production)
AWS_REGION=us-east-1
AWS_SECRET_PREFIX=jt-inventory/

# SNMP Defaults
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# Logging
LOG_LEVEL=INFO

# Nautobot Integration
NAUTOBOT_URL=https://nautobot.example.com
NAUTOBOT_TOKEN=your-api-token-here
NAUTOBOT_VERIFY_SSL=true
NAUTOBOT_TAG_NAME=Nova Inventory

# Authentication
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Password can be plaintext (for dev) or a werkzeug hash (for production)
# Generate hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password', method='pbkdf2:sha256'))"
# Or run inside the container:
#   docker compose exec app python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password', method='pbkdf2:sha256'))"
# IMPORTANT: In .env files used with docker-compose, escape $ as $$
# Example: pbkdf2:sha256:1000000$$salt$$hash (note the double dollar signs)
AUTH_PASSWORD_HASH=change-this-password
SECRET_KEY=change-this-to-a-random-secret-key
SESSION_LIFETIME_HOURS=24
